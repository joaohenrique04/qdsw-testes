{
  "name": "r-book-lib",
  "version": "1.0.0",
  "description": "Sistema de Biblioteca R Book Lib",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "dependencies": {
    "prompt-sync": "^4.2.0"
  },
  "devDependencies": {
    "jest": "^30.0.0"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/app.js",
      "!src/ui/**"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 90,
        "branches": 90
      }
    }
  }
}
